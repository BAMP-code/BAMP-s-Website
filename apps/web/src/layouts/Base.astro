---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "bamp.codes — Bryan Pineda",
  description = "Bryan Pineda — Stanford CS·AI. Autonomous agents, ML pipelines, and full-stack systems. Open to new work.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a07" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-surface text-primary font-body antialiased">
    <a href="#work" class="skip-link">Skip to work</a>

    <!-- Scanline + corner-bracket HUD frame (fixed, decorative). -->
    <div class="hud-scanlines" aria-hidden="true"></div>
    <div class="hud-corner hud-corner--tl" aria-hidden="true"></div>
    <div class="hud-corner hud-corner--tr" aria-hidden="true"></div>
    <div class="hud-corner hud-corner--bl" aria-hidden="true"></div>
    <div class="hud-corner hud-corner--br" aria-hidden="true"></div>

    <slot />

    <script>
      import { initScroll } from "@/lib/scroll";
      initScroll();
    </script>
  </body>
</html>
