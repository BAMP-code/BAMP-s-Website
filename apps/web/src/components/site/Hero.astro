---
const lead =
  "I graduated from Stanford. Now I'm a founding engineer at Alterion, leading the AI team.";

const meta = [
  { k: "Discipline", v: "Stanford University · CS, AI Track" },
  { k: "Role", v: "Founding Engineer, AI @ Alterion" },
  { k: "Stack", v: "Python · PyTorch · TypeScript" },
];
---

<header id="top" class="px-6 pb-10 pt-16 sm:px-10 sm:pt-20">
  <span
    class="hero-status hero-boot inline-flex items-center gap-2 rounded-sm border border-accent/40 px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.2em] text-accent"
  >
    <span class="status-dot"></span>
    SYS.ONLINE — Open to new work · SF Bay Area
  </span>

  <h1
    class="hero-headline hero-boot font-display mt-6 text-[clamp(3.4rem,13vw,11rem)] leading-[0.82] tracking-[0.005em] text-card-title"
  >
    Bryan<br /><span class="glitch text-hazard" data-text="Pineda.">Pineda.</span>
  </h1>

  <p class="hero-lead hero-boot mt-7 max-w-2xl font-body text-lg leading-relaxed text-card-body">
    {lead}
  </p>

  <dl
    class="hero-meta mt-9 flex flex-col gap-3 border-t border-border pt-6 font-mono text-[0.82rem] text-muted sm:flex-row sm:flex-wrap sm:justify-between sm:gap-6"
  >
    {
      meta.map((m) => (
        <div class="hero-boot flex flex-col gap-1">
          <dt class="text-[0.6rem] uppercase tracking-[0.2em] text-muted/70">
            {m.k}
          </dt>
          <dd class="text-primary">
            <span class="text-hazard">▹</span> {m.v}
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="reveal mt-10">
    <a
      href="#work"
      data-magnetic
      data-cursor="Scroll"
      class="inline-flex items-center gap-2 rounded-sm bg-hazard px-6 py-3.5 font-mono text-xs uppercase tracking-[0.14em] text-surface transition-colors hover:bg-[#fff6a3]"
    >
      View the work ↓
    </a>
  </div>
</header>
