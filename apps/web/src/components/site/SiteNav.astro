---
// Top HUD nav. Brand wordmark + section anchors + a real "FX" toggle
// that mirrors wodniack's contrast toggle: it disables scanlines/glitch
// for anyone who wants a calmer read, persisted in localStorage. Also
// carries a persistent résumé/contact CTA pair so those actions aren't
// only reachable by scrolling all the way to the footer.
import { about } from "@/content/about";

const links = [
  { label: "About", href: "#about" },
  { label: "Work", href: "#work" },
  { label: "Contact", href: "#contact" },
];
---

<nav
  class="sticky top-0 z-40 flex items-center justify-between border-b border-border bg-surface/85 px-6 py-4 backdrop-blur-md sm:px-10"
  aria-label="Primary"
>
  <a href="#top" class="font-mono text-sm font-semibold tracking-[0.26em] text-hazard">
    BAMP<span class="text-muted">//</span>
  </a>

  <div class="flex items-center gap-6">
    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="font-mono text-xs uppercase tracking-[0.16em] text-muted transition-colors hover:text-hazard"
            >
              <span class="text-hazard">›</span> {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="fx-toggle"
      type="button"
      aria-pressed="false"
      class="font-mono text-xs uppercase tracking-[0.16em] text-muted transition-colors hover:text-hazard"
    >
      <span aria-hidden="true">◑</span> FX <span id="fx-state" class="text-hazard">ON</span>
    </button>

    {
      about.resumeUrl && (
        <a
          href={about.resumeUrl}
          download
          target="_blank"
          rel="noopener noreferrer"
          data-magnetic
          data-cursor="Save"
          aria-label="Download résumé"
          class="inline-flex items-center gap-1.5 rounded-full border border-border px-3.5 py-2 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-primary transition-colors hover:border-hazard hover:text-hazard"
        >
          <span aria-hidden="true">⤓</span>
          <span class="hidden sm:inline">Résumé</span>
        </a>
      )
    }
    <a
      href="#contact"
      data-magnetic
      data-cursor="Go"
      class="inline-flex items-center gap-1.5 rounded-full bg-hazard px-3.5 py-2 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-surface transition-colors hover:bg-[#fff6a3]"
    >
      <span class="hidden sm:inline">Let's talk</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</nav>

<script>
  const KEY = "bamp-fx";
  const root = document.documentElement;
  const btn = document.getElementById("fx-toggle");
  const state = document.getElementById("fx-state");

  function apply(off: boolean) {
    root.classList.toggle("fx-off", off);
    if (state) state.textContent = off ? "OFF" : "ON";
    btn?.setAttribute("aria-pressed", off ? "true" : "false");
  }

  // Initial fx-off state is applied in <head> before paint (see Base.astro),
  // so here we only reflect the current class in the button UI.
  apply(root.classList.contains("fx-off"));

  btn?.addEventListener("click", () => {
    const off = !root.classList.contains("fx-off");
    localStorage.setItem(KEY, off ? "off" : "on");
    apply(off);
  });
</script>
