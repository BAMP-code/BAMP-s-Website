---
import { getProjects, getCategories } from "@/lib/projects";
import BinaryRule from "./BinaryRule.astro";

// Deterministic Night-City hash per project, e.g. #0x9F3·0001/10
function hashFor(slug: string, index: number, total: number): string {
  let h = 0;
  for (const ch of slug) h = (h * 31 + ch.charCodeAt(0)) & 0xffff;
  const hex = h.toString(16).toUpperCase().padStart(3, "0").slice(0, 3);
  const n = String(index + 1).padStart(4, "0");
  return `#0x${hex}·${n}/${total}`;
}

const [projects, categories] = await Promise.all([getProjects(), getCategories()]);
const total = projects.length;
---

<section id="work" class="scroll-mt-20 px-6 sm:px-10">
  <BinaryRule label="Selected Work" class="py-4" />

  <div class="flex items-end justify-between gap-4 pb-2 pt-4">
    <h2 class="reveal font-display text-[clamp(1.6rem,4vw,2.6rem)] leading-none text-card-title">
      Selected Work
    </h2>
    <span class="reveal label whitespace-nowrap">
      {total} shipped · 2021—2026
    </span>
  </div>

  <div
    id="work-filters"
    class="reveal flex flex-wrap gap-2 pb-6"
    role="group"
    aria-label="Filter work by category"
  >
    <button
      type="button"
      class="filter-pill rounded-full border border-border px-4 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-muted transition-colors hover:border-hazard hover:text-hazard aria-pressed:border-hazard aria-pressed:bg-hazard aria-pressed:text-surface"
      data-filter="all"
      aria-pressed="true"
    >
      All
    </button>
    {
      categories.map((c) => (
        <button
          type="button"
          class="filter-pill rounded-full border border-border px-4 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-muted transition-colors hover:border-hazard hover:text-hazard aria-pressed:border-hazard aria-pressed:bg-hazard aria-pressed:text-surface"
          data-filter={c.slug}
          aria-pressed="false"
        >
          {c.label}
        </button>
      ))
    }
  </div>

  <div class="border-t border-border">
    {
      projects.map((p, i) => (
        <details class="work-row reveal" data-category={p.category.slug}>
          <summary>
            <span class="work-idx">{String(i + 1).padStart(2, "0")}</span>
            <span class="work-title">{p.title}</span>
            <span class="work-cat">{p.category.label}</span>
            <span class="work-hash">{hashFor(p.slug, i, total)}</span>
            <span class="work-arrow" aria-hidden="true">↗</span>
          </summary>
          <div class="work-panel">
            <div class="flex flex-col gap-4">
              <p class="font-body text-base leading-relaxed text-card-body">
                {p.description}
              </p>
              <span
                class:list={[
                  "label",
                  p.status === "in-progress" ? "text-signal" : "text-muted",
                ]}
              >
                {p.status === "in-progress" ? "◐ In progress" : "● Completed"}
              </span>
            </div>
            <div class="work-media">
              {p.media.type === "video" ? (
                <video
                  src={p.media.src}
                  width={p.media.width}
                  height={p.media.height}
                  controls
                  preload="metadata"
                  playsinline
                  aria-label={p.media.alt}
                ></video>
              ) : (
                <img
                  src={p.media.src}
                  alt={p.media.alt}
                  width={p.media.width}
                  height={p.media.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          </div>
        </details>
      ))
    }
  </div>
</section>

<script>
  // Smoothly animate <details> open/close (native toggle just snaps).
  // Web Animations API on the element height; content fade handled in
  // CSS. Reduced-motion users keep the instant native behaviour.
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  class WorkAccordion {
    el: HTMLDetailsElement;
    summary: HTMLElement;
    panel: HTMLElement;
    animation: Animation | null = null;
    panelAnim: Animation | null = null;
    isClosing = false;
    isExpanding = false;

    constructor(el: HTMLDetailsElement) {
      this.el = el;
      this.summary = el.querySelector("summary") as HTMLElement;
      this.panel = el.querySelector(".work-panel") as HTMLElement;
      this.summary.addEventListener("click", (e) => this.onClick(e));
    }

    onClick(e: MouseEvent) {
      e.preventDefault();
      this.el.style.overflow = "hidden";
      if (this.isClosing || !this.el.open) this.open();
      else if (this.isExpanding || this.el.open) this.shrink();
    }

    open() {
      // Exclusive accordion: close any other open row on the way in.
      WorkAccordion.registry.forEach((a) => {
        if (a !== this && a.el.open) a.shrink();
      });
      this.el.style.height = `${this.el.offsetHeight}px`;
      this.el.open = true;
      window.requestAnimationFrame(() => this.expand());
    }

    expand() {
      this.isExpanding = true;
      const start = `${this.el.offsetHeight}px`;
      const end = `${this.summary.offsetHeight + this.panel.offsetHeight}px`;
      this.animation?.cancel();
      this.panelAnim?.cancel();
      this.animation = this.el.animate(
        { height: [start, end] },
        { duration: 360, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
      );
      // Content eases in just behind the height.
      this.panelAnim = this.panel.animate(
        { opacity: [0, 1], transform: ["translateY(10px)", "none"] },
        { duration: 300, delay: 60, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "backwards" },
      );
      this.animation.onfinish = () => this.onFinish(true);
      this.animation.oncancel = () => (this.isExpanding = false);
    }

    shrink() {
      this.isClosing = true;
      const start = `${this.el.offsetHeight}px`;
      const end = `${this.summary.offsetHeight}px`;
      this.animation?.cancel();
      this.panelAnim?.cancel();
      // Fade the media out quickly (and hold it hidden) so it's gone well
      // before the row finishes collapsing.
      this.panelAnim = this.panel.animate(
        { opacity: [1, 0], transform: ["none", "translateY(6px)"] },
        { duration: 150, easing: "ease-out", fill: "forwards" },
      );
      this.animation = this.el.animate(
        { height: [start, end] },
        { duration: 300, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
      );
      this.animation.onfinish = () => this.onFinish(false);
      this.animation.oncancel = () => (this.isClosing = false);
    }

    onFinish(open: boolean) {
      this.el.open = open;
      this.animation = null;
      this.isClosing = this.isExpanding = false;
      this.el.style.height = this.el.style.overflow = "";
    }

    static registry: WorkAccordion[] = [];
  }

  const rows = Array.from(
    document.querySelectorAll<HTMLDetailsElement>("details.work-row"),
  );

  if (!reduceMotion) {
    rows.forEach((el) => WorkAccordion.registry.push(new WorkAccordion(el)));
  }

  // Category filter pills — pure client-side show/hide, since every
  // project is already baked into the page at build time.
  const filterBar = document.getElementById("work-filters");
  const filterButtons = Array.from(
    filterBar?.querySelectorAll<HTMLButtonElement>("[data-filter]") ?? [],
  );

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.dataset.filter ?? "all";

      filterButtons.forEach((b) =>
        b.setAttribute("aria-pressed", b === btn ? "true" : "false"),
      );

      rows.forEach((row) => {
        const matches = filter === "all" || row.dataset.category === filter;
        if (matches) {
          row.classList.remove("hidden");
          return;
        }
        if (!row.open) {
          row.classList.add("hidden");
          return;
        }
        // Let an open row finish its close animation before hiding it,
        // instead of cutting the collapse off with display:none.
        const accordion = WorkAccordion.registry.find((a) => a.el === row);
        if (!accordion) {
          row.open = false;
          row.classList.add("hidden");
          return;
        }
        row.addEventListener("toggle", function onToggle() {
          if (!row.open) {
            row.classList.add("hidden");
            row.removeEventListener("toggle", onToggle);
          }
        });
        accordion.shrink();
      });
    });
  });
</script>
