---
// Mid-page conversion point: visitors who've just scrolled the work list
// are more likely to reach out right here than at the page's very end.
---

<section class="border-y border-border bg-surface-alt py-14">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-6 sm:px-10">
    <div class="reveal">
      <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-muted">
        Hiring, recruiting, or just curious
      </p>
      <h3 class="font-display mt-2 text-[clamp(1.7rem,4vw,2.6rem)] leading-none text-card-title">
        Let's build something loud.
      </h3>
    </div>
    <a
      href="#contact"
      data-magnetic
      data-cursor="Go"
      class="reveal inline-flex items-center gap-2 rounded-sm bg-hazard px-6 py-3.5 font-mono text-xs uppercase tracking-[0.14em] text-surface transition-colors hover:bg-[#fff6a3]"
    >
      Start a conversation →
    </a>
  </div>
</section>
