# Copy to .env and fill in from your Supabase project's
# Settings → API page. SUPABASE_ANON_KEY is the public "anon" key —
# safe to use here since it's scoped by the read-only RLS policies in
# apps/web/supabase/schema.sql. Never put the service_role key in this
# file or in Vercel — it bypasses RLS entirely.
SUPABASE_URL=
SUPABASE_ANON_KEY=
