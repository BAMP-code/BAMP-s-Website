---
// Floating speaker / mute toggle. Audio is silent until the user
// interacts (browser autoplay policy); first scroll or click triggers
// startAudio(). Mute state persists in localStorage.
---

<button
  id="audio-toggle"
  type="button"
  aria-label="Toggle audio"
  aria-pressed="false"
  class="fixed bottom-5 right-5 z-50 flex h-11 w-11 items-center justify-center rounded-pill border border-accent/30 bg-surface-alt/80 text-accent backdrop-blur transition-colors hover:border-accent hover:text-accent"
>
  <svg
    id="audio-on-icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    aria-hidden="true"
  >
    <path d="M11 5L6 9H2v6h4l5 4V5z" />
    <path d="M15.5 8.5a4 4 0 010 7" />
    <path d="M18.5 5.5a8 8 0 010 13" />
  </svg>
  <svg
    id="audio-off-icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    aria-hidden="true"
    style="display: none;"
  >
    <path d="M11 5L6 9H2v6h4l5 4V5z" />
    <path d="M22 9l-6 6" />
    <path d="M16 9l6 6" />
  </svg>
</button>

<script>
  import {
    startAudio,
    setMuted,
    isMuted,
    isStarted,
    getStoredMute,
  } from "@/lib/audio";

  const button = document.getElementById("audio-toggle");
  const onIcon = document.getElementById("audio-on-icon");
  const offIcon = document.getElementById("audio-off-icon");

  function syncIcon(muted: boolean) {
    if (onIcon) onIcon.style.display = muted ? "none" : "block";
    if (offIcon) offIcon.style.display = muted ? "block" : "none";
    button?.setAttribute("aria-pressed", muted ? "true" : "false");
  }

  // Reflect stored state immediately so the icon doesn't flicker on
  // first paint.
  const stored = getStoredMute();
  if (stored !== null) syncIcon(stored);

  window.addEventListener("audio:state", (event: Event) => {
    const detail = (event as CustomEvent<{ muted: boolean }>).detail;
    syncIcon(detail.muted);
  });

  // Start audio on first user gesture (autoplay policy).
  const startOnGesture = () => {
    if (!isStarted()) startAudio();
    document.removeEventListener("click", startOnGesture);
    document.removeEventListener("scroll", startOnGesture);
    document.removeEventListener("wheel", startOnGesture);
    document.removeEventListener("touchstart", startOnGesture);
  };
  document.addEventListener("click", startOnGesture);
  document.addEventListener("scroll", startOnGesture, { passive: true });
  document.addEventListener("wheel", startOnGesture, { passive: true });
  document.addEventListener("touchstart", startOnGesture, { passive: true });

  button?.addEventListener("click", (event) => {
    event.stopPropagation();
    if (!isStarted()) startAudio();
    setMuted(!isMuted());
  });
</script>
