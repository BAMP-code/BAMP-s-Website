---
import Base from "@/layouts/Base.astro";
import { CityScene } from "@/components/scene";
import { projects } from "@/content/projects";
import { about } from "@/content/about";

const categoryLabel: Record<string, string> = {
  cs: "Computer Science",
  "ee-me": "Electrical / Mechanical",
  drawings: "Drawings",
};
---

<Base>
  <!-- Sticky 3D scene layer + 1500vh scroll runway. Camera Y descends
       through the runway via @/lib/scroll → CameraRig. -->
  <div class="relative h-[1500vh]">
    <div class="sticky top-0 left-0 z-0 h-screen w-screen">
      <CityScene client:only="react" />
    </div>
  </div>

  <main class="relative z-10 mx-auto max-w-3xl px-6 py-16">
    <header class="mb-12 border-b border-border pb-8">
      <p class="text-xs uppercase tracking-[0.32em] text-accent">
        bamp.codes v2 — content port
      </p>
      <h1 class="mt-3 text-5xl font-extrabold tracking-tight text-card-title">
        {about.headline}
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-card-body">
        {about.bio}
      </p>
    </header>

    <section id="projects" class="mb-12">
      <h2 class="mb-6 text-sm uppercase tracking-[0.28em] text-muted">
        Projects ({projects.length})
      </h2>
      <ul class="space-y-3">
        {
          projects.map((p) => (
            <li class="rounded-card border border-border bg-surface-alt px-4 py-3">
              <div class="flex items-baseline justify-between gap-4">
                <span class="text-base font-semibold text-card-title">
                  {p.title}
                </span>
                <span class="shrink-0 text-xs uppercase tracking-[0.18em] text-accent">
                  {categoryLabel[p.category] ?? p.category}
                </span>
              </div>
              <p class="mt-1 text-sm leading-relaxed text-muted">
                {p.description}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="about" class="mb-12">
      <h2 class="mb-3 text-sm uppercase tracking-[0.28em] text-muted">
        Education & skills
      </h2>
      <p class="text-sm text-card-body">{about.education}</p>
      {
        about.skills && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {about.skills.map((s) => (
              <li class="rounded-pill border border-border bg-surface-alt px-3 py-1 text-xs text-muted">
                {s}
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="mb-12">
      <h2 class="mb-3 text-sm uppercase tracking-[0.28em] text-muted">
        Find me
      </h2>
      <ul class="flex flex-wrap gap-3">
        {
          about.socials.map((s) => (
            <li>
              <a
                href={s.url}
                aria-label={s.label}
                class="rounded-pill border border-accent/30 px-3 py-1 text-xs text-accent/80 transition-colors hover:border-accent hover:text-accent"
              >
                {s.platform}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="border-t border-border pt-6 text-xs text-muted">
      Placeholder render. The cyberpunk scene + scroll bind land in
      Merges 3 and 4 (see <code class="text-accent">docs/REFACTOR_VISION.md</code>).
    </footer>
  </main>
</Base>
